{{!
    @template local_a11y/option_toggle

    A single boolean accessibility option row (switch control).

    Context variables required for this template:
    * id - option id, e.g. "readableFont"
    * iconsvg - raw inline <svg> markup
    * label - option label text
    * desc - option description text or null

    Example context (json):
    {
        "id": "readableFont",
        "iconsvg": "<svg></svg>",
        "label": "Readable Font",
        "desc": "Applies Atkinson Hyperlegible"
    }
}}
<div class="local-a11y-option" data-region="option" data-option-id="{{id}}" data-kind="toggle" role="button" tabindex="0">
    <span class="local-a11y-option__icon">{{{iconsvg}}}</span>
    <span class="local-a11y-option__text">
        <span class="local-a11y-option__label">{{label}}</span>
        {{#desc}}<span class="local-a11y-option__desc">{{desc}}</span>{{/desc}}
    </span>
    <button type="button" class="local-a11y-switch" data-region="switch" aria-pressed="false" aria-label="{{label}}">
        <span class="local-a11y-switch__thumb"></span>
    </button>
</div>
