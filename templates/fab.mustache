{{!
    @template local_a11y/fab

    The floating accessibility button.

    @description The floating accessibility button.
    @package    Moodle
    @subpackage Plugin a11y
    @author     Rodrigo Padilha Silveira <padilhars@gmail.com>
    @author     Jerônimo Medina Madruga <jeronimo.madruga@gmail.com>
    @copyright  Universidade Federal de Pelotas - UFPel
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    @version    0.1.0
    @since      0.1.0

    Context variables required for this template:
    * positionclass - CSS modifier class for FAB position
    * shapeclass - CSS modifier class for circle/square
    * iconclass - optional extra CSS modifier class for the icon wrapper (empty string if none)
    * iconsvg - raw inline <svg> markup
    * ariaopenlabel - accessible label when closed
    * accent - hex accent colour

    Example context (json):
    {
        "positionclass": "local-a11y-fab--bottom-right",
        "shapeclass": "local-a11y-fab--circle",
        "iconclass": "",
        "iconsvg": "<svg></svg>",
        "ariaopenlabel": "Open accessibility panel",
        "accent": "#3b82f6"
    }
}}
<button
    type="button"
    id="local-a11y-fab"
    class="local-a11y-root local-a11y-fab {{positionclass}} {{shapeclass}}"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="local-a11y-panel"
    aria-label="{{ariaopenlabel}}"
    style="--local-a11y-accent: {{accent}};"
>
    <span class="local-a11y-fab__icon {{iconclass}}">{{{iconsvg}}}</span>
    <span class="local-a11y-fab__badge" data-region="badge"{{^hasactive}} hidden{{/hasactive}}>{{activecount}}</span>
</button>
